{
  "permissions": {
    "deny": [
      "Edit(**/*.cs)",
      "Edit(**/*.csproj)",
      "Edit(**/*.sln)",
      "Edit(**/*.sql)",
      "Edit(**/Dockerfile)",
      "Edit(**/*.razor)",
      "Bash(dotnet new *)",
      "Bash(dotnet ef *)",
      "Bash(dotnet aspnet-codegenerator *)"
    ],
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-source.sh"
          }
        ]
      }
    ]
  }
}
